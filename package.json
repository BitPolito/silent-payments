{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "cd api && ./venv/bin/flask --app index run -p 5328",
    "dev:rust": "cargo build --locked --release --manifest-path native/vanity/Cargo.toml",
    "dev": "npm run build:vanity && concurrently -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "lint": "eslint src",
    "prune:i18n": "node scripts/prune-i18n.mjs",
    "prune:i18n:unused": "node scripts/prune-unused-i18n.mjs",
    "verify:errors": "vitest run src/utils/api.test.js",
    "build:vanity": "cargo build --locked --release --manifest-path native/vanity/Cargo.toml",
    "vercel-build": "python3 scripts/build-vanity.py && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:api": "api/venv/bin/python -m pytest"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@zxing/library": "^0.21.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pdfjs-dist": "^5.4.624",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "@tailwindcss/vite": "^4.3.3"
  }
}
